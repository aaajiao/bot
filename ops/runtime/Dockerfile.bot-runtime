# Retained-server-image runtime migration only; see runtime-maintenance.md.
# The output is private: legacy /app can contain credentials or application data.
ARG LEGACY_IMAGE=archive-local/bot-crazyplayer:retained-8c6e214a43db
FROM ${LEGACY_IMAGE} AS legacy
FROM node:24.22.1-alpine@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53
WORKDIR /app
COPY --from=legacy /app /app
COPY nuxt-node24.cjs /app/ops/runtime/nuxt-node24.cjs
CMD ["node", "/app/ops/runtime/nuxt-node24.cjs", "start"]
